<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/mx_bg_dark"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">

    <!-- Video Thumbnail -->
    <RelativeLayout
        android:id="@+id/thumbnailContainer"
        android:layout_width="120dp"
        android:layout_height="70dp"
        android:layout_alignParentStart="true">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardCornerRadius="6dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/imgThumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#2C3A4E"
                android:scaleType="centerCrop" />
        </androidx.cardview.widget.CardView>

        <!-- Time Badge on Thumbnail -->
        <TextView
            android:id="@+id/txtDurationBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            android:layout_margin="4dp"
            android:background="#B3000000"
            android:paddingHorizontal="4dp"
            android:paddingVertical="2dp"
            android:text="00:00"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Title -->
    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/thumbnailContainer"
        android:layout_toStartOf="@+id/btnMore"
        android:layout_marginStart="12dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/mx_text_primary"
        android:textSize="14sp" />

    <!-- 3-Dot Options Menu -->
    <ImageView
        android:id="@+id/btnMore"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:padding="4dp"
        android:src="@android:drawable/ic_menu_more"
        app:tint="@color/mx_text_secondary" />

</RelativeLayout>
